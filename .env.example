# ═══════════════════════════════════════════════════════════════════
# render-service-manager — env vars template (copy to .env and fill in)
# Tokens and keys are NEVER committed (.env is gitignored).
# ═══════════════════════════════════════════════════════════════════

# ── Manager ────────────────────────────────────────────────────────
# URL of the deployed manager service. Used by the TUI and the helper
# scripts (example: https://your-manager-host.example).
MANAGER_URL=

# Token to call /tick and /fetch (X-Auth-Token header). If empty the
# manager stays open. On Render: set it!
MANAGER_AUTH_TOKEN=

# Active services, comma-separated ids as declared in services.yaml.
# Unset/commented = all; set to a subset to run only those; set to an
# empty value = none.
# SERVICES_ENABLED=

# 1 = automatic daily script fetch on the first tick of each day (disable: 0)
DAILY_FETCH=1

# NOTE: the per-service tick cadence is declared in services.yaml
# (schedule.mode: every_tick | interval_minutes | disabled)

# Automatic process restart when the fetch changes the scripts
# (on Render the restart is intended and platform-managed; locally set 0
# so uvicorn does not die during tests)
RESTART_ON_CHANGE=1

# ── The SECRET manifest ──────────────────────────────────────────────
# services.yaml is secret (gitignored, never published). Pick ONE
# delivery channel:
# A) on Render, RECOMMENDED: a Secret File named services.yaml
#    (dashboard -> Environment -> Secret Files; plain multiline YAML,
#    no escaping) - the manager reads it at boot; optional explicit
#    pointer: MANIFEST_FILE=/etc/secrets/services.yaml
# B) a private GitHub repository as manifest deposit:
# MANIFEST_REPO=owner/private-manifest-repo
# MANIFEST_BRANCH=main        (default)
# MANIFEST_PATH=services.yaml (default)
# C) the whole YAML as an env var (single line, escaped \n):
# MANIFEST_CONTENT=services:\n  ticker:\n    ...
# No channel and no local services.yaml -> the manager boots with a
# clear config_error and no service runs.

# ── Service variables (${VAR} placeholders in services.yaml) ────────
# Services declared in services.yaml can reference ${VAR} placeholders
# that are resolved from the environment: add here one variable per
# service, with your own names. Example (fake) entries — replace them:
MYSERVICE_REPO=owner/my-service-repo
MYSERVICE_API_KEY=

# GitHub token used to fetch private source repos (services with
# mode: api). It needs read access to those repositories.
GITHUB_TOKEN=
