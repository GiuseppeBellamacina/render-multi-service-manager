# ═══════════════════════════════════════════════════════════════════
# render-service-manager — env vars template (copy to .env and fill in)
# Tokens and keys are NEVER committed (.env is gitignored).
# ═══════════════════════════════════════════════════════════════════

# ── Manager ────────────────────────────────────────────────────────
# Token to call /tick and /fetch (X-Auth-Token header). If empty the
# manager stays open (like the original services). On Render: set it!
# NB: it also accepts T2G_AUTH_TOKEN, so the TUI keeps working.
MANAGER_AUTH_TOKEN=

# Active services (default: all). For targeted tests: "committer", "t2g",
# "credit", or empty for none
SERVICES_ENABLED=committer,t2g,credit

# 1 = automatic daily script fetch on the first tick of each day (disable: 0)
DAILY_FETCH=1

# NOTE: the per-service tick cadence is declared in services.yaml
# (schedule.mode: every_tick | interval_minutes | disabled)

# Automatic process restart when the fetch changes the scripts
# (on Render the restart is intended and platform-managed; locally set 0
# so uvicorn does not die during tests)
RESTART_ON_CHANGE=1

# ── The SECRET manifest (services.yaml) ─────────────────────────────
# Locally a services.yaml file is enough. On Render pick ONE:
# A) the whole YAML as an env var (multiline with literal \n):
# MANIFEST_CONTENT=services:\n  ticker:\n    ...
# B) a private GitHub repository acting as a manifest deposit:
# MANIFEST_REPO=owner/private-manifest-repo
# MANIFEST_BRANCH=main
# MANIFEST_PATH=services.yaml

# ── Service sources (${VAR} placeholders in services.yaml) ──────────
# The repos the manager fetches the scripts from. Private ones (mode: api)
# require the GITHUB_TOKEN below.
COMMITTER_REPO=owner/committer-repo
CREDIT_REPO=owner/credit-repo
T2G_REPO=owner/cluster-driver-repo

# ── Committer ───────────────────────────────────────────────────────
GITHUB_TOKEN=
# target repo for the commits (e.g. owner/repo)
GITHUB_REPO=
GITHUB_USERNAME=
BASE_COMMITS=10
DELTA_COMMITS=2
WORK_START_HOUR=9
WORK_END_HOUR=18
TIMEZONE_OFFSET=2

# ── T2G (cluster driver) ─────────────────────────────────────────────
T2G_AUTH_TOKEN=
T2G_SSH_USER=
# LOCALLY: leave the line COMMENTED OUT -> the service uses its own default
# (a ~/.ssh/config alias, if configured). WARNING: an empty 'T2G_SSH_HOST='
# line counts as SET-TO-EMPTY and disables the default. On Render/Docker:
# explicit login node host.
# T2G_SSH_HOST=login-node.example.edu
# Entire private key with literal \n (Render/Docker only):
# T2G_SSH_KEY_CONTENT=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----
T2G_SSH_TIMEOUT=30

# ── Credit (OpenRouter monitor) ─────────────────────────────────────
# NB: the service code reads UPSTASH_REDIS_URL / UPSTASH_REDIS_TOKEN
# (NOT the *_REST_* names: those belong to a different, older .env)
OPENROUTER_API_KEY=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=