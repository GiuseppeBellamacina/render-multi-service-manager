# local secrets
.env
.env.render

# session exports (contain secrets and private details)
session-*.md

# the SECRET manifest: the manager downloads services.yaml at boot (from
# MANIFEST_CONTENT / MANIFEST_REPO) and caches it here - NEVER commit it;
# services.yaml.example is the published reference
services.yaml

# private manifest deposit repo (has its own .git)
render-manifests

# local-only service code copies (last-known-good)
fallback/

# local environment
.venv/

# manager runtime (generated by the manager itself)
services/
state/
data/
logs/
__pycache__/
*.pyc
*.log
backup_credits.jsonl
state.json
known_hosts*
ssh_key*
*.db